# Projekt Supabase BEAUTY (dhuvykwecsxgchzxufxw)
NEXT_PUBLIC_SUPABASE_URL=https://dhuvykwecsxgchzxufxw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Klucz serwisowy - omija RLS. Tylko po stronie serwera, nigdy w kodzie klienta
# i nigdy w zmiennej z prefiksem NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare ---
# Lokalnie wystarczy ten plik (.env.local). Na produkcji zmienne ustawia sie w Workers:
#
#   npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY
#   npx wrangler secret put NEXT_PUBLIC_SUPABASE_ANON_KEY
#
# Uwaga: zmienne NEXT_PUBLIC_* sa wstrzykiwane podczas builda, wiec musza byc
# dostepne rowniez w srodowisku budowania (Workers Builds -> Variables).
