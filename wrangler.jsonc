{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mienie-wnioski",
  // Własny punkt wejścia: handler OpenNext (.open-next/worker.js) + harmonogram przypomnień.
  "main": "cloudflare-worker.mjs",
  "compatibility_date": "2026-09-22",
  // Wymagane przez ExcelJS (node:stream, node:zlib, node:buffer).
  // Od daty zgodnosci 2026-08-04 flaga jest domyslna, ale zostawiamy ja jawnie,
  // zeby cofniecie compatibility_date nie wylaczylo po cichu obslugi Node.
  "compatibility_flags": ["nodejs_compat"],
  // Aplikacja odpowiada wyłącznie pod wnioski.auraexpert.pl (domena podpięta w panelu
  // Cloudflare). Bez tego działałaby też pod *.workers.dev i pod adresami podglądu
  // starszych wersji — z produkcyjnymi sekretami i kodem sprzed poprawek.
  // Wrangler przy wdrożeniu zmienia tylko ustawienie subdomeny, domeny nie rusza.
  "workers_dev": false,
  "preview_urls": false,
  // Uwaga: NIE deklarujemy tu `secrets.required`. Walidacja wranglera sprawdza
  // bindings deploymentu, a sekret trafia do bindings wylacznie przez
  // `--secrets-file` albo `--var`. Przy komendzie `npx wrangler deploy`
  // deklaracja blokowalaby kazdy deploy, nie dajac sie spelnic.
  // Brak klucza wykrywa /api/stan i granice bledu w aplikacji.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Codziennie o 8:05 UTC (9:05 zimą, 10:05 latem w Polsce): przypomnienia o niezłożonych
  // wnioskach (src/lib/przypomnienia.ts, wywołanie w cloudflare-worker.mjs).
  "triggers": {
    "crons": ["5 8 * * *"]
  },
  "observability": {
    "enabled": true
  },
  // Zmienne jawne trzymamy tutaj, nie w panelu: `wrangler deploy` przy kazdym
  // wdrozeniu usuwa zmienne ustawione recznie w panelu Cloudflare.
  // Sekrety (RESEND_API_KEY itd.) zostaja w panelu — deploy ich nie rusza.
  "vars": {
    "RESEND_SENDER": "Wniosek ubezpieczeniowy <hub@auraexpert.pl>"
  }
}
