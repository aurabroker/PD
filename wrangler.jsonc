{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mienie-wnioski",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-22",
  // Wymagane przez ExcelJS (node:stream, node:zlib, node:buffer).
  // Od daty zgodnosci 2026-08-04 flaga jest domyslna, ale zostawiamy ja jawnie,
  // zeby cofniecie compatibility_date nie wylaczylo po cichu obslugi Node.
  "compatibility_flags": ["nodejs_compat"],
  // Deploy ma sie NIE UDAC, jesli tego sekretu brakuje na Workerze.
  // Bez tego brak klucza wychodzi dopiero w runtime, jako blad przy pierwszym
  // zapisie. Uwaga: zwykla zmienna (tekst jawny) ustawiona w panelu jest
  // nadpisywana przy kazdym `wrangler deploy` - sekrety przetrwaja deploy.
  "secrets": {
    "required": ["SUPABASE_SERVICE_ROLE_KEY"]
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
